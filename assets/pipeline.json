{
  "schemaVersion": 2,
  "resourceKey": "pipeline.example.items.v2",
  "storage": {
    "listRef": {
      "kind": "list",
      "resourceKey": "list.example.items.v2"
    }
  },
  "pipeline": {
    "name": "Example Pipeline",
    "description": "A portable Git-backed pipeline machine definition.",
    "columns": [
      {
        "id": "col_name",
        "key": "name",
        "label": "Name",
        "type": "text",
        "required": true,
        "order": 0
      }
    ],
    "stages": [
      {
        "id": "new",
        "name": "New",
        "type": "initial",
        "order": 0
      },
      {
        "id": "done",
        "name": "Done",
        "type": "terminal",
        "order": 1
      }
    ],
    "transitions": [
      {
        "id": "new__complete",
        "name": "Complete",
        "fromStageId": "new",
        "toStageId": "done",
        "trigger": "manual",
        "success": {
          "advanceToStageId": "done",
          "persistMode": "shared_patch",
          "fieldMappings": []
        }
      }
    ]
  },
  "commitMessage": "Update pipeline machine definition"
}
